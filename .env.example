# This file is needed on local pipeline deploy
# RUN `npm run config:push` TO SYNC SSM TO THESE VALUES

# -----------------------------------------------------------------------------
# Tooling account (where the pipeline itself runs)
# -----------------------------------------------------------------------------

# REQUIRED: 12-digit AWS account ID that hosts the CodePipeline.
TOOLING_ACCOUNT=000000000000

# Region for the pipeline. Defaults to CDK_DEFAULT_REGION or us-east-1.
TOOLING_REGION=us-east-1

# Optional override for the pipeline resource name in CodePipeline. Default:
# InnovationSandboxPipeline
# PIPELINE_NAME=InnovationSandboxPipeline


# -----------------------------------------------------------------------------
# Source repositories
# -----------------------------------------------------------------------------

# REQUIRED: CodeStar Connection ARNs. You need two if the upstream repo and
# pipeline repo are in different GitHub orgs/accounts.
UPSTREAM_CODESTAR_CONNECTION_ARN=arn:aws:codeconnections:us-east-1:000000000000:connection/REPLACE-ME
PIPELINE_CODESTAR_CONNECTION_ARN=arn:aws:codeconnections:us-east-1:000000000000:connection/REPLACE-ME

# Upstream Innovation Sandbox repo (defaults shown).
# GITHUB_OWNER=aws-solutions
# GITHUB_REPO=innovation-sandbox-on-aws
# GITHUB_BRANCH=main

# REQUIRED: This pipeline repo.
PIPELINE_GITHUB_OWNER=org
PIPELINE_GITHUB_REPO=isb-deploy-pipeline
# PIPELINE_GITHUB_BRANCH=main


# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------

# IMPORTANT! Do not include this until the stack has been deployed once. Known CDK limitation

# Comma-separated emails for pipeline failure / approval notifications.
# NOTIFICATION_EMAILS=platform-oncall@example.com


# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------

# Build and push a private AWS Nuke ECR image. Default: false.
# BUILD_AND_PUSH_NUKE_IMAGE=false


# -----------------------------------------------------------------------------
# Config parameter / re-trigger behaviour
# -----------------------------------------------------------------------------

# SSM parameter the synth step reads this config from, and the parameter the
# pipeline's config-change EventBridge rule watches. Default: /isb-pipeline/config
# CONFIG_PARAMETER_NAME=/isb-pipeline/config

# Start a pipeline execution whenever the config parameter above is created or
# updated, from any source (npm run config:push, the console, other tooling).
# Without this a config change is not picked up until some unrelated git push
# happens to start a run. Default: true
# TRIGGER_ON_CONFIG_CHANGE=true

# Reject a pending manual approval when a newer execution is blocked behind it.
# SUPERSEDED mode only supersedes executions BETWEEN stages, so an execution
# parked on an approval holds its stage lock and newer executions sit at
# "Inbound" until a human answers or the (non-configurable) seven-day approval
# timeout expires. Default: true
# UNBLOCK_STALE_APPROVALS=true


# -----------------------------------------------------------------------------
# Dev stage
# -----------------------------------------------------------------------------
# A stage is enabled only when ALL THREE of its *_ACCOUNT vars are set.

DEV_ORG_MGT_ACCOUNT=
DEV_IDC_ACCOUNT=
DEV_HUB_ACCOUNT=
# DEV_REGION=us-east-1
# DEV_NAMESPACE=dev

# Pipeline behavior
# DEV_REQUIRE_MANUAL_APPROVAL=false
# DEV_RUN_INTEGRATION_TESTS=true
# DEV_APPROVAL_EMAILS=

# Upstream config (passed to cdk deploy)
DEV_IDENTITY_STORE_ID=
DEV_SSO_INSTANCE_ARN=
DEV_PARENT_OU_ID=
DEV_AWS_REGIONS=us-east-1
# DEV_ACCEPT_SOLUTION_TERMS_OF_USE=Accept
# DEV_ADMIN_GROUP_NAME=InnovationSandboxAdmins
# DEV_MANAGER_GROUP_NAME=InnovationSandboxManagers
# DEV_USER_GROUP_NAME=InnovationSandboxUsers
# DEV_ALLOWED_IP_ADDRESSES=0.0.0.0/0
# DEV_AWS_NUKE_DRY_RUN_MODE=false



# -----------------------------------------------------------------------------
# Staging stage
# -----------------------------------------------------------------------------

STAGING_ORG_MGT_ACCOUNT=
STAGING_IDC_ACCOUNT=
STAGING_HUB_ACCOUNT=
# STAGING_REGION=us-east-1
# STAGING_NAMESPACE=staging

# Pipeline behavior
# STAGING_REQUIRE_MANUAL_APPROVAL=true
# STAGING_RUN_INTEGRATION_TESTS=false
# STAGING_APPROVAL_EMAILS=platform-leads@example.com

# Upstream config (passed to cdk deploy)
# STAGING_IDENTITY_STORE_ID=
# STAGING_SSO_INSTANCE_ARN=
# STAGING_PARENT_OU_ID=
# STAGING_AWS_REGIONS=us-east-1
# STAGING_ACCEPT_SOLUTION_TERMS_OF_USE=Accept
# STAGING_ADMIN_GROUP_NAME=InnovationSandboxAdmins
# STAGING_MANAGER_GROUP_NAME=InnovationSandboxManagers
# STAGING_USER_GROUP_NAME=InnovationSandboxUsers
# STAGING_ALLOWED_IP_ADDRESSES=0.0.0.0/0
# STAGING_AWS_NUKE_DRY_RUN_MODE=false



# -----------------------------------------------------------------------------
# Prod stage
# -----------------------------------------------------------------------------

PROD_ORG_MGT_ACCOUNT=
PROD_IDC_ACCOUNT=
PROD_HUB_ACCOUNT=
# PROD_REGION=us-east-1
# PROD_NAMESPACE=prod

# Pipeline behavior
# PROD_REQUIRE_MANUAL_APPROVAL=true
# PROD_RUN_INTEGRATION_TESTS=false
# PROD_APPROVAL_EMAILS=platform-leads@example.com

# Upstream config (passed to cdk deploy)
# PROD_IDENTITY_STORE_ID=
# PROD_SSO_INSTANCE_ARN=
# PROD_PARENT_OU_ID=
# PROD_AWS_REGIONS=us-east-1
# PROD_ACCEPT_SOLUTION_TERMS_OF_USE=Accept
# PROD_ADMIN_GROUP_NAME=InnovationSandboxAdmins
# PROD_MANAGER_GROUP_NAME=InnovationSandboxManagers
# PROD_USER_GROUP_NAME=InnovationSandboxUsers
# PROD_ALLOWED_IP_ADDRESSES=0.0.0.0/0
# PROD_AWS_NUKE_DRY_RUN_MODE=false



# -----------------------------------------------------------------------------
# Single-account install (optional)
# -----------------------------------------------------------------------------
# For a minimal single-account deployment, set TOOLING_ACCOUNT and all three
# DEV_*_ACCOUNT variables to the same 12-digit account ID, leave Staging/Prod
# unset, and the pipeline will deploy a single Dev wave into that account.
