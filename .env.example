# To refresh SSM with up to date values

# -----------------------------------------------------------------------------
# Tooling account (where the pipeline itself runs)
# -----------------------------------------------------------------------------

# REQUIRED: 12-digit AWS account ID that hosts the CodePipeline.
TOOLING_ACCOUNT=000000000000

# Region for the pipeline. Defaults to CDK_DEFAULT_REGION or us-east-1.
TOOLING_REGION=us-east-1

# Optional override for the pipeline resource name in CodePipeline. Default:
# InnovationSandboxPipeline
PIPELINE_NAME=InnovationSandboxPipeline


# -----------------------------------------------------------------------------
# Source repository (upstream Innovation Sandbox)
# -----------------------------------------------------------------------------

# REQUIRED: ARN of an AWS CodeStar Connections connection to GitHub.
# Create one at: AWS Console -> Developer Tools -> Settings -> Connections.
# You need two connections if the upstream repo and pipeline repo are in
# different GitHub orgs/accounts.
UPSTREAM_CODESTAR_CONNECTION_ARN=arn:aws:codeconnections:us-east-1:000000000000:connection/REPLACE-ME
PIPELINE_CODESTAR_CONNECTION_ARN=arn:aws:codeconnections:us-east-1:000000000000:connection/REPLACE-ME

# Optional: GitHub source location overrides. Defaults shown.
# GITHUB_OWNER=aws-solutions
# GITHUB_REPO=innovation-sandbox-on-aws
# GITHUB_BRANCH=main


# -----------------------------------------------------------------------------
# Pipeline repository (this repo — required for self-mutation)
# -----------------------------------------------------------------------------

# REQUIRED: GitHub owner/org and repo name for this pipeline repository.
PIPELINE_GITHUB_OWNER=your-org
PIPELINE_GITHUB_REPO=isb-deploy-pipeline

# Optional: branch to track. Defaults to "main".
# PIPELINE_GITHUB_BRANCH=main


# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------

# Comma-separated list of email addresses to subscribe to pipeline failure /
# approval notifications. Leave blank to disable.
NOTIFICATION_EMAILS=platform-oncall@example.com


# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------

# If true, the pipeline builds the AWS Nuke Docker image and pushes it to a
# private ECR repository in each Hub account before deploying the Compute
# stack. Requires an `InnovationSandboxEcrPushRole` in each Hub account that
# trusts the tooling account. Default: false (uses upstream's public image).
BUILD_AND_PUSH_NUKE_IMAGE=false


# -----------------------------------------------------------------------------
# Dev stage
# -----------------------------------------------------------------------------
# A stage is enabled only when ALL THREE of its *_ACCOUNT vars are set.

DEV_ORG_MGT_ACCOUNT=
DEV_IDC_ACCOUNT=
DEV_HUB_ACCOUNT=

# Region overrides for this stage. Defaults to TOOLING_REGION.
# DEV_REGION=us-east-1

# If true, a manual approval gate is added in front of the Dev wave. Default
# for Dev is `false` (deploy directly on every commit).
# DEV_REQUIRE_MANUAL_APPROVAL=false

# If true, run integration tests after Compute deploy. Default for Dev is
# `true`.
# DEV_RUN_INTEGRATION_TESTS=true

# Comma-separated emails to notify when an approval is pending (only used when
# DEV_REQUIRE_MANUAL_APPROVAL=true).
# DEV_APPROVAL_EMAILS=

# Optional override for the upstream NAMESPACE env var. Defaults to "dev".
# DEV_NAMESPACE=dev

# -- Upstream Innovation Sandbox config (passed straight to `cdk deploy`) ----
# Get the IAM Identity Center values via:
#   aws sso-admin list-instances --region <YOUR_REGION> \
#     --query 'Instances[0].[IdentityStoreId,InstanceArn]' --output text
DEV_IDENTITY_STORE_ID=
DEV_SSO_INSTANCE_ARN=

# REQUIRED: The Organizations root or OU ID where sandbox accounts live.
# Find via: aws organizations list-roots --query 'Roots[0].Id' --output text
DEV_PARENT_OU_ID=
# Comma-separated AWS regions the sandbox manages.
DEV_AWS_REGIONS=us-east-1

# Optional. If unset, upstream uses its built-in defaults.
# DEV_ADMIN_GROUP_NAME=InnovationSandboxAdmins
# DEV_MANAGER_GROUP_NAME=InnovationSandboxManagers
# DEV_USER_GROUP_NAME=InnovationSandboxUsers
# DEV_ALLOWED_IP_ADDRESSES=0.0.0.0/0
# DEV_AWS_NUKE_DRY_RUN_MODE=false
# DEV_ACCEPT_SOLUTION_TERMS_OF_USE=true


# -----------------------------------------------------------------------------
# Staging stage
# -----------------------------------------------------------------------------

STAGING_ORG_MGT_ACCOUNT=
STAGING_IDC_ACCOUNT=
STAGING_HUB_ACCOUNT=

# STAGING_REGION=us-east-1

# Default for Staging is `true` (manual approval required before deploy).
# STAGING_REQUIRE_MANUAL_APPROVAL=true

# Default for Staging is `false`.
# STAGING_RUN_INTEGRATION_TESTS=false

# STAGING_APPROVAL_EMAILS=platform-leads@example.com
# STAGING_NAMESPACE=staging

# -- Upstream Innovation Sandbox config (same shape as DEV_*) ---------------
# STAGING_IDENTITY_STORE_ID=
# STAGING_SSO_INSTANCE_ARN=
# STAGING_ADMIN_GROUP_NAME=InnovationSandboxAdmins
# STAGING_MANAGER_GROUP_NAME=InnovationSandboxManagers
# STAGING_USER_GROUP_NAME=InnovationSandboxUsers
# STAGING_ALLOWED_IP_ADDRESSES=0.0.0.0/0
# STAGING_AWS_NUKE_DRY_RUN_MODE=false
# STAGING_ACCEPT_SOLUTION_TERMS_OF_USE=true


# -----------------------------------------------------------------------------
# Prod stage
# -----------------------------------------------------------------------------

PROD_ORG_MGT_ACCOUNT=
PROD_IDC_ACCOUNT=
PROD_HUB_ACCOUNT=

# PROD_REGION=us-east-1

# Default for Prod is `true`.
# PROD_REQUIRE_MANUAL_APPROVAL=true

# Default for Prod is `false`.
# PROD_RUN_INTEGRATION_TESTS=false

# PROD_APPROVAL_EMAILS=platform-leads@example.com
# PROD_NAMESPACE=prod

# -- Upstream Innovation Sandbox config (same shape as DEV_*) ---------------
# PROD_IDENTITY_STORE_ID=
# PROD_SSO_INSTANCE_ARN=
# PROD_ADMIN_GROUP_NAME=InnovationSandboxAdmins
# PROD_MANAGER_GROUP_NAME=InnovationSandboxManagers
# PROD_USER_GROUP_NAME=InnovationSandboxUsers
# PROD_ALLOWED_IP_ADDRESSES=0.0.0.0/0
# PROD_AWS_NUKE_DRY_RUN_MODE=false
# PROD_ACCEPT_SOLUTION_TERMS_OF_USE=true


# -----------------------------------------------------------------------------
# Single-account install (optional)
# -----------------------------------------------------------------------------
# For a minimal single-account deployment, set TOOLING_ACCOUNT and all three
# DEV_*_ACCOUNT variables to the same 12-digit account ID, leave Staging/Prod
# unset, and the pipeline will deploy a single Dev wave into that account.
