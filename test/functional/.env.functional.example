# Functional test configuration
# Copy this file to .env.functional and fill in values.
# This file is .gitignored.

# ISB API (get JWT from browser sessionStorage key "isb-jwt")
ISB_API_URL=https://<cloudfront-domain>/api
ISB_API_TOKEN=

# Hub account AWS credentials (for API calls and account status checks)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Region / namespace
ISB_HUB_REGION=us-west-2
ISB_NAMESPACE=myisb

# Supported regions the sandbox provisions into and verifies deletion in.
# Comma-separated; mirror your deployment's AWS_REGIONS / IsbManagedRegions.
# Defaults to ISB_HUB_REGION if unset.
ISB_SANDBOX_REGIONS=us-west-2,us-east-1,us-east-2

# Smallest instance type to launch during the sandbox stage (optional).
ISB_TEST_INSTANCE_TYPE=t3.nano

# Category 2 (sandbox) only: leased sandbox account credentials.
# Get these from the SSO portal after leasing an account in Category 1.
# ISB_SANDBOX_AWS_ACCESS_KEY_ID=
# ISB_SANDBOX_AWS_SECRET_ACCESS_KEY=
# ISB_SANDBOX_AWS_SESSION_TOKEN=

# Category 3 (teardown) and Category 4 (verify-deletion): ADMIN credentials already
# authorized in the sandbox account, or credentials able to assume the admin role
# in the sandbox account after the lease is terminated.
# Falls back to the AWS_* credentials above.
# ISB_ADMIN_AWS_ACCESS_KEY_ID=
# ISB_ADMIN_AWS_SECRET_ACCESS_KEY=
# ISB_ADMIN_AWS_SESSION_TOKEN=

# Role the admin credentials assume inside the sandbox account (optional).
# Organizations creates OrganizationAccountAccessRole by default.
ISB_ADMIN_ASSUME_ROLE_NAME=OrganizationAccountAccessRole
