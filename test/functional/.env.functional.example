# Functional test configuration
# Copy this file to .env.functional and fill in values.
# This file is .gitignored.

# v1.3 API authentication: copy the Cognito user-pool idToken from Local Storage.
# The tests exchange it through the Cognito Identity Pool and sign API requests
# with temporary IAM credentials. Do not use the accessToken or refreshToken.
ISB_API_URL=
ISB_API_REGION=us-west-2
ISB_API_ID_TOKEN=
ISB_COGNITO_IDENTITY_POOL_ID=

# Admin credentials used by the cleanup stages. These are separate from the
# Cognito token above and provide the fallback admin credentials for teardown
# unless ISB_ADMIN_AWS_* is set below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Region / namespace
ISB_HUB_REGION=us-west-2
ISB_NAMESPACE=myisb

# Supported regions the sandbox provisions into and verifies deletion in.
# Comma-separated; mirror your deployment's AWS_REGIONS / IsbManagedRegions.
# Defaults to ISB_HUB_REGION if unset.
ISB_SANDBOX_REGIONS=us-west-2,us-east-1

# Smallest instance type to launch during the sandbox stage (optional).
ISB_TEST_INSTANCE_TYPE=t3.nano

# Category 2 (sandbox) only: leased sandbox account credentials.
# Get these from the SSO portal after leasing an account in Category 1.
# ISB_SANDBOX_AWS_ACCESS_KEY_ID=
# ISB_SANDBOX_AWS_SECRET_ACCESS_KEY=
# ISB_SANDBOX_AWS_SESSION_TOKEN=

# Category 3 (teardown) and Category 4 (verify-deletion): ADMIN credentials already
# authorized in the sandbox account. These are used directly by default.
# Set ISB_ADMIN_ASSUME_ROLE_NAME only when an explicit cross-account role
# assumption is required.
# Falls back to the AWS_* credentials above.
# ISB_ADMIN_AWS_ACCESS_KEY_ID=
# ISB_ADMIN_AWS_SECRET_ACCESS_KEY=
# ISB_ADMIN_AWS_SESSION_TOKEN=

# Optional explicit role assumption. Leave blank for direct credentials.
ISB_ADMIN_ASSUME_ROLE_NAME=
